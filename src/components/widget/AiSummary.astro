---
import { Icon } from "astro-icon/components";

interface Props {
	description: string;
	descriptionSource?: "manual" | "ai" | string;
}

const { description, descriptionSource = "ai" } = Astro.props;

const isManual = descriptionSource === "manual";
const sourceLabel = isManual ? "人工编写" : "AI 摘要";
const iconName = isManual
	? "material-symbols:person"
	: "material-symbols:psychology";
---

<aside
  class="ai-summary-wrapper rounded-xl mb-6 onload-animation"
  data-ai-summary
  data-pagefind-ignore
  role="note"
  aria-label={sourceLabel}
>
  <div class="ai-summary">
    <div class="ai-summary-header">
      <div class="ai-summary-icon" aria-hidden="true">
        <Icon name={iconName} class="text-base" />
      </div>
      <span class="ai-summary-label">{sourceLabel}</span>
    </div>
    <div class="ai-summary-content">
      <p class="ai-summary-text" data-ai-summary-text data-full-text={description}>
        {description}
      </p>
      <span class="ai-summary-cursor" data-ai-summary-cursor aria-hidden="true"></span>
    </div>
  </div>
</aside>

<style>
  .ai-summary-wrapper {
    position: relative;
    overflow: hidden;
    background: var(--card-bg);
    border: 1px solid var(--line-divider);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .ai-summary-wrapper::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    content: "";
    background: linear-gradient(
      180deg,
      var(--primary) 0%,
      color-mix(in srgb, var(--primary) 50%, transparent) 100%
    );
  }

  .ai-summary {
    padding: 1rem 1.25rem 1rem 1.5rem;
  }

  .ai-summary-header {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .ai-summary-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    border-radius: 0.375rem;
    transition: background-color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .ai-summary:hover .ai-summary-icon {
    background: color-mix(in srgb, var(--primary) 18%, transparent);
    transform: scale(1.05);
  }

  .ai-summary-label {
    color: var(--btn-content);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .ai-summary-content {
    display: flex;
    gap: 1px;
    align-items: flex-start;
  }

  .ai-summary-text {
    min-height: 1.8em;
    margin: 0;
    color: var(--btn-content);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .ai-summary-cursor {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin: 0.35em 0 0 2px;
    opacity: 0;
    background: var(--primary);
    border-radius: 1px;
    animation: none;
    flex-shrink: 0;
  }

  .ai-summary-cursor.active {
    opacity: 1;
    animation: cursor-blink 0.8s step-end infinite;
  }

  .ai-summary-text.typing {
    animation: text-fade-in 0.3s ease-out;
  }

  .ai-summary-wrapper:hover {
    border-color: color-mix(in srgb, var(--primary) 40%, transparent);
    box-shadow: 0 4px 16px rgb(0 0 0 / 8%);
  }

  :global(html.dark) .ai-summary-wrapper:hover {
    box-shadow: 0 4px 16px rgb(0 0 0 / 30%);
  }

  @keyframes cursor-blink {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }
  }

  @keyframes text-fade-in {
    from {
      opacity: 0.6;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-summary-wrapper,
    .ai-summary-icon,
    .ai-summary-text,
    .ai-summary-cursor {
      transition: none;
      animation: none;
    }
  }
</style>

<script is:inline>
  (function setupAiSummaries() {
    function initAiSummaries() {
      var summaries = document.querySelectorAll("[data-ai-summary]");

      for (var summaryIndex = 0; summaryIndex < summaries.length; summaryIndex++) {
        var summary = summaries[summaryIndex];
        if (summary.getAttribute("data-ai-summary-initialized") === "true") continue;
        summary.setAttribute("data-ai-summary-initialized", "true");

        var summaryText = summary.querySelector("[data-ai-summary-text]");
        var cursor = summary.querySelector("[data-ai-summary-cursor]");
        if (!summaryText) continue;

        var fullText =
          summaryText.getAttribute("data-full-text") || summaryText.textContent || "";
        summaryText.textContent = fullText;
        if (!fullText) continue;

        var prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (prefersReducedMotion) continue;

        var characters = Array.from(fullText);
        var speed = Math.max(12, Math.min(32, Math.round(2200 / characters.length)));
        var hasRun = false;

        function startTyping() {
          if (hasRun) return;
          hasRun = true;

          var characterIndex = 0;
          summaryText.textContent = "";
          summaryText.classList.add("typing");
          if (cursor) cursor.classList.add("active");

          function tick() {
            if (!summary.isConnected) return;

            if (characterIndex < characters.length) {
              var character = characters[characterIndex];
              summaryText.textContent += character;
              characterIndex++;

              var delay = speed;
              if ("。！？.!?".includes(character)) {
                delay = speed * 5;
              } else if ("，、；：,;:".includes(character)) {
                delay = speed * 2.5;
              }
              window.setTimeout(tick, delay);
              return;
            }

            summaryText.classList.remove("typing");
            if (cursor) {
              window.setTimeout(function() {
                cursor.classList.remove("active");
              }, 1200);
            }
          }

          window.setTimeout(tick, 200);
        }

        if ("IntersectionObserver" in window) {
          var observer = new IntersectionObserver(
            function(entries) {
              for (var entryIndex = 0; entryIndex < entries.length; entryIndex++) {
                if (entries[entryIndex].isIntersecting) {
                  observer.disconnect();
                  startTyping();
                  break;
                }
              }
            },
            { threshold: 0.2 }
          );
          observer.observe(summary);
        } else {
          startTyping();
        }
      }
    }

    initAiSummaries();

    var listenerFlag = "data-ai-summary-listeners-bound";
    if (!document.documentElement.hasAttribute(listenerFlag)) {
      document.documentElement.setAttribute(listenerFlag, "true");
      document.addEventListener("astro:page-load", initAiSummaries);
      document.addEventListener("swup:contentReplaced", initAiSummaries);
    }
  })();
</script>
